# Copy to .env and adjust. Never commit .env.
# Backend
APP_ENV=development
DATABASE_URL=postgresql+psycopg2://provena:provena@localhost:5433/provena
CORS_ORIGINS=http://localhost:5173
# Signing key for JWT access tokens. The built-in default is for local
# development only. Set a long random value for any shared deployment.
SECRET_KEY=change-me-in-production
# Password for users created by the dev seed (backend: python -m app.seed).
# Local development only.
SEED_DEV_PASSWORD=provena-dev
# Evidence file storage root (local filesystem). Runtime uploads only.
EVIDENCE_STORAGE_ROOT=./evidence-storage
# Maximum accepted evidence upload size in bytes (default 100 MiB).
EVIDENCE_MAX_UPLOAD_BYTES=104857600
# Optional local report narrative generation. Leave disabled for reliable
# deterministic reports without Ollama.
LLM_ENABLED=false
LLM_PROVIDER=deterministic
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Choose a model that fits the local machine, for example qwen3:4b.
OLLAMA_MODEL=
LLM_TIMEOUT_SECONDS=30
# Frontend (Vite exposes only VITE_* variables to the browser)
VITE_API_URL=http://localhost:8000
